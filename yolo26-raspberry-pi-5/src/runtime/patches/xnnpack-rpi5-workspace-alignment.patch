diff --git a/sources/xnnpack/src/runtime.c b/sources/xnnpack/src/runtime.c
index 8761d15..b510b68 100644
--- a/sources/xnnpack/src/runtime.c
+++ b/sources/xnnpack/src/runtime.c
@@ -239,7 +239,15 @@ static enum xnn_status initialize_workspace_values(
   // Allocates larger workspace here if needed.
   if (runtime->workspace->size < mem_arena_size) {
     void* old_workspace_data = runtime->workspace->data;
-    void* new_workspace_data = xnn_allocate_zero_simd_memory(mem_arena_size);
+    // The Cortex-A76 has 64-byte cache lines. XNNPACK's 16-byte SIMD
+    // alignment leaves this heavily reused arena at one of four cache-line
+    // offsets and produces address-dependent latency on Raspberry Pi 5.
+    // Keep the workspace base on a cache-line boundary.
+    void* new_workspace_data = xnn_params.allocator.aligned_allocate(
+      xnn_params.allocator.context, 64, mem_arena_size);
+    if (new_workspace_data != NULL) {
+      memset(new_workspace_data, 0, mem_arena_size);
+    }
     if (new_workspace_data == NULL) {
       xnn_log_error("failed to allocate %zu bytes for runtime workspace", mem_arena_size);
       return xnn_status_out_of_memory;
