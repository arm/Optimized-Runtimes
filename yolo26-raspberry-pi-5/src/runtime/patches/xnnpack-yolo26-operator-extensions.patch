+// Project-owned implementation for the explicitly tagged model.2 C2f
+// concatenate. It combines three 16-channel NHWC FP16 inputs into one
+// 48-channel output in a single row-parallel operator. Spatial dimensions are
+// deliberately dynamic, so every supported YOLO26n resolution uses this path.
+struct yolo26n_fused_concat_x16_context {
+  const uint16_t* input0;
+  const uint16_t* input1;
+  const uint16_t* input2;
+  uint16_t* output;
+};
+
+static bool yolo26n_fused_concat_contract_matches(
+  const struct xnn_operator_data* opdata,
+  const struct xnn_runtime_value* values,
+  size_t num_values,
+  int32_t axis)
+{
+  if (opdata->num_inputs != 3 || opdata->num_outputs != 1 || axis != 3) {
+    return false;
+  }
+  for (size_t i = 0; i < 3; i++) {
+    if (opdata->inputs[i] >= num_values) {
+      return false;
+    }
+    const struct xnn_runtime_value* input = &values[opdata->inputs[i]];
+    if (input->datatype != xnn_datatype_fp16 || input->shape.num_dims != 4 ||
+        input->shape.dim[0] != 1 || input->shape.dim[3] != 16) {
+      return false;
+    }
+    if (i != 0 &&
+        (input->shape.dim[1] != values[opdata->inputs[0]].shape.dim[1] ||
+         input->shape.dim[2] != values[opdata->inputs[0]].shape.dim[2])) {
+      return false;
+    }
+  }
+  if (opdata->outputs[0] >= num_values) {
+    return false;
+  }
+  const struct xnn_runtime_value* output = &values[opdata->outputs[0]];
+  return output->datatype == xnn_datatype_fp16 && output->shape.num_dims == 4 &&
+      output->shape.dim[0] == 1 &&
+      output->shape.dim[1] == values[opdata->inputs[0]].shape.dim[1] &&
+      output->shape.dim[2] == values[opdata->inputs[0]].shape.dim[2] &&
+      output->shape.dim[3] == 48;
+}
+
+static void yolo26n_compute_fused_concat_x16(
+  struct yolo26n_fused_concat_x16_context* context,
+  size_t row,
+  size_t rows)
+{
+  for (size_t i = row; i < row + rows; i++) {
+    uint16_t* output = context->output + i * 48;
+    memcpy(output, context->input0 + i * 16, 16 * sizeof(uint16_t));
+    memcpy(output + 16, context->input1 + i * 16, 16 * sizeof(uint16_t));
+    memcpy(output + 32, context->input2 + i * 16, 16 * sizeof(uint16_t));
+  }
+}
