+enum xnn_status xnn_enable_yolo26_f16_igemm_silu_final_store(
+    xnn_operator_t op) {
+  // This mutates XNNPACK's selected microkernel table after operator creation.
+  // It is safe only for the two fixed YOLO26n convolutions and the exact stock
+  // 1x16/6x16 FP16 kernels from which the fused entry points are derived.
+  // Check every invariant before changing either function pointer so an
+  // upstream dispatch change becomes an initialization error.
+  if (op == NULL || op->type != xnn_operator_type_convolution_nhwc_f16 ||
+      op->ukernel.type != xnn_microkernel_type_igemm ||
+      op->ukernel.igemm == NULL || op->convolution_op == NULL) {
+    xnn_log_error(
+        "YOLO26 IGEMM-SiLU final-store tag did not select static FP16 IGEMM");
+    return xnn_status_invalid_state;
+  }
+  const struct xnn_convolution_operator* conv = op->convolution_op;
+  const bool stem =
+      conv->kernel_height == 3 && conv->kernel_width == 3 &&
+      conv->stride_height == 2 && conv->stride_width == 2 &&
+      conv->dilation_height == 1 && conv->dilation_width == 1 &&
+      conv->groups == 1 && conv->group_input_channels == 3 &&
+      conv->group_output_channels == 16 && op->input_pixel_stride == 3 &&
+      op->output_pixel_stride == 16;
+  const bool downsample =
+      conv->kernel_height == 3 && conv->kernel_width == 3 &&
+      conv->stride_height == 2 && conv->stride_width == 2 &&
+      conv->dilation_height == 1 && conv->dilation_width == 1 &&
+      conv->groups == 1 && conv->group_input_channels == 16 &&
+      conv->group_output_channels == 32 && op->input_pixel_stride == 16 &&
+      op->output_pixel_stride == 32;
+  struct xnn_ukernel_igemm* igemm = op->ukernel.igemm;
+  if ((!stem && !downsample) || igemm->mr != 6 || igemm->nr != 16 ||
+      igemm->kr != 1 || igemm->sr != 1 ||
+      igemm->igemm_cases[0].function[XNN_UARCH_DEFAULT] !=
+          (xnn_igemm_ukernel_fn)
+              xnn_f16_igemm_minmax_ukernel_1x16__asm_aarch64_neonfp16arith_ld64 ||
+      igemm->igemm_cases[5].function[XNN_UARCH_DEFAULT] !=
+          (xnn_igemm_ukernel_fn)
+              xnn_f16_igemm_minmax_ukernel_6x16__asm_aarch64_neonfp16arith_cortex_a75) {
+    xnn_log_error("YOLO26 IGEMM-SiLU final-store identity mismatch");
+    return xnn_status_invalid_state;
+  }
+  igemm->igemm_cases[0].function[XNN_UARCH_DEFAULT] =
+      (xnn_igemm_ukernel_fn)
+          xnn_yolo26_f16_igemm_silu_1x16__asm_aarch64_neonfp16arith_ld64;
+  igemm->igemm_cases[5].function[XNN_UARCH_DEFAULT] =
+      (xnn_igemm_ukernel_fn)
+          xnn_yolo26_f16_igemm_silu_6x16__asm_aarch64_neonfp16arith_cortex_a75;
+  return xnn_status_success;
+}
