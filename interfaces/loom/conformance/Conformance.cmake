include_guard(GLOBAL)
function(loom_require_gtest)
  if(NOT TARGET GTest::gtest_main)
    find_package(GTest QUIET)
  endif()
  if(NOT TARGET GTest::gtest_main)
    include(FetchContent)
    set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
    set(BUILD_GMOCK OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(googletest
      URL https://codeload.github.com/google/googletest/zip/refs/tags/v1.17.0
      URL_HASH SHA256=40d4ec942217dcc84a9ebe2a68584ada7d4a33a8ee958755763278ea1c5e18ff)
    FetchContent_MakeAvailable(googletest)
  endif()
endfunction()
function(loom_add_conformance name provider)
  set(LOOM_INTERFACE_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  loom_require_gtest()
  add_executable(${name} "${LOOM_INTERFACE_DIR}/conformance/host_conformance_test.cpp" "${provider}")
  target_compile_features(${name} PRIVATE cxx_std_17)
  target_include_directories(${name} PRIVATE "${LOOM_INTERFACE_DIR}" "${LOOM_INTERFACE_DIR}/conformance")
  target_link_libraries(${name} PRIVATE GTest::gtest_main ${ARGN})
endfunction()
function(loom_declaration_tests)
  set(LOOM_INTERFACE_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  foreach(language IN ITEMS c cpp)
    set(source "${CMAKE_CURRENT_BINARY_DIR}/loom_header.${language}")
    configure_file("${LOOM_INTERFACE_DIR}/tests/header_contract.c" "${source}" COPYONLY)
    add_executable(loom_header_${language} "${source}")
    target_include_directories(loom_header_${language} PRIVATE "${LOOM_INTERFACE_DIR}")
    set_target_properties(loom_header_${language} PROPERTIES C_STANDARD 11 CXX_STANDARD 11 C_EXTENSIONS OFF CXX_EXTENSIONS OFF)
    target_compile_options(loom_header_${language} PRIVATE -Wall -Wextra -Werror -pedantic)
    add_test(NAME loom_header_${language} COMMAND loom_header_${language})
  endforeach()
  find_path(LOOM_VULKAN_INCLUDE_DIR vulkan/vulkan.h)
  if(LOOM_VULKAN_INCLUDE_DIR)
    foreach(language IN ITEMS c cpp)
      foreach(order IN ITEMS core_first vulkan_first)
        set(source "${CMAKE_CURRENT_BINARY_DIR}/loom_vulkan_${order}.${language}")
        configure_file("${LOOM_INTERFACE_DIR}/tests/vulkan_header_contract.c" "${source}" COPYONLY)
        add_executable(loom_vulkan_${language}_${order} "${source}")
        target_include_directories(loom_vulkan_${language}_${order} PRIVATE "${LOOM_INTERFACE_DIR}" "${LOOM_VULKAN_INCLUDE_DIR}")
        target_compile_features(loom_vulkan_${language}_${order} PRIVATE c_std_11 cxx_std_11)
        target_compile_options(loom_vulkan_${language}_${order} PRIVATE -Wall -Wextra -Werror -pedantic)
        if(order STREQUAL "core_first")
          target_compile_definitions(loom_vulkan_${language}_${order} PRIVATE LRT_TEST_CORE_FIRST)
        endif()
        add_test(NAME loom_vulkan_${language}_${order} COMMAND loom_vulkan_${language}_${order})
      endforeach()
    endforeach()
  endif()
endfunction()
