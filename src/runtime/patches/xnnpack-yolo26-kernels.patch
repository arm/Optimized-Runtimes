+    vst1q_u16(o, vreinterpretq_u16_f16(vf0)); o += 8;
+    vst1q_u16(o, vreinterpretq_u16_f16(vf1)); o += 8;
+    vst1q_u16(o, vreinterpretq_u16_f16(vf2)); o += 8;
