+    float16x8_t vn1 = vfmaq_f16(vmagic_bias, vz1, vminus_log2e);
+    float16x8_t vn2 = vfmaq_f16(vmagic_bias, vz2, vminus_log2e);
+    float16x8_t vn3 = vfmaq_f16(vmagic_bias, vz3, vminus_log2e);
