+    const float16x8_t vx1 = vreinterpretq_f16_u16(vld1q_u16(i)); i += 8;
+    const float16x8_t vx2 = vreinterpretq_f16_u16(vld1q_u16(i)); i += 8;
+    const float16x8_t vx3 = vreinterpretq_f16_u16(vld1q_u16(i)); i += 8;
