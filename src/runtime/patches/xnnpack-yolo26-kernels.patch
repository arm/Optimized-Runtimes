+    }
+    if (batch & (2 * sizeof(uint16_t))) {
+      vst1_lane_u32((void*) o, vreinterpret_u32_f16(vf_lo), 0); o += 2;
+      vf_lo = vext_f16(vf_lo, vf_lo, 2);
+    }
+    if (batch & (1 * sizeof(uint16_t))) {
+      vst1_lane_u16(o, vreinterpret_u16_f16(vf_lo), 0);
+    }
+  }
