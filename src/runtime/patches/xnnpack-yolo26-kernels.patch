+    const float16x8_t vp = vfmaq_f16(vc1, vc2, vt);
+    vt = vmulq_f16(vt, vs);
+    const float16x8_t ve = vfmaq_f16(vs, vp, vt);
+    const float16x8_t vd = vaddq_f16(ve, vone);
