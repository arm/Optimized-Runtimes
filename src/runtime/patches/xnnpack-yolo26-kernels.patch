+    vr4567 = vmulq_f32(vr4567, vrecpsq_f32(vr4567, vd4567));
+    vr89AB = vmulq_f32(vr89AB, vrecpsq_f32(vr89AB, vd89AB));
+    vrCDEF = vmulq_f32(vrCDEF, vrecpsq_f32(vrCDEF, vdCDEF));
+
+    vr0123 = vmulq_f32(vr0123, vrecpsq_f32(vr0123, vd0123));
+    vr4567 = vmulq_f32(vr4567, vrecpsq_f32(vr4567, vd4567));
+    vr89AB = vmulq_f32(vr89AB, vrecpsq_f32(vr89AB, vd89AB));
+    vrCDEF = vmulq_f32(vrCDEF, vrecpsq_f32(vrCDEF, vdCDEF));
+
