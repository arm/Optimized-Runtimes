+    float32x4_t vf4567 = vmulq_f32(vy4567, vr4567);
+    float32x4_t vf89AB = vmulq_f32(vy89AB, vr89AB);
+    float32x4_t vfCDEF = vmulq_f32(vyCDEF, vrCDEF);
