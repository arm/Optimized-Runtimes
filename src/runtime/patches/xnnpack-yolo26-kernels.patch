+// remainder, then the final multiply by x is performed before storing. `batch`
+// is a byte count, so each four-lane vector consumes 4 * sizeof(float) bytes.
+void xnn_f32_vsilu_ukernel__neonfma_rr1_lut64_p2_nr2recps_u16(
+    size_t batch,
+    const float* input,
+    float* output,
+    const struct xnn_f32_default_params* restrict params) XNN_OOB_READS
+{
