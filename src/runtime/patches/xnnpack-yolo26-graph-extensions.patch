diff --git a/sources/xnnpack/src/subgraph/convolution-2d.c b/sources/xnnpack/src/subgraph/convolution-2d.c
index 1af737a..f58fc91 100644
--- a/sources/xnnpack/src/subgraph/convolution-2d.c
+++ b/sources/xnnpack/src/subgraph/convolution-2d.c
@@ -105,6 +105,19 @@ static enum xnn_status create_convolution_operator(
     const struct xnn_node* node, const struct xnn_runtime_value* values,
     size_t num_values, struct xnn_operator_data* opdata,
     xnn_weights_cache_t weights_cache) {
+  // The stock convolution constructors do not understand the project flag.
+  // Remove it while selecting and creating the ordinary operator, then verify
+  // and replace that operator's final-store microkernel below. A mismatch is
+  // an error: silently keeping the stock kernel would omit the SiLU operation
+  // represented by this tagged node.
+  const bool yolo26_igemm_silu_final_store =
+      (node->flags & XNN_FLAG_YOLO26_IGEMM_SILU_FINAL_STORE) != 0;
+  struct xnn_node clean_node;
+  if (yolo26_igemm_silu_final_store) {
+    clean_node = *node;
+    clean_node.flags &= ~XNN_FLAG_YOLO26_IGEMM_SILU_FINAL_STORE;
+    node = &clean_node;
+  }
   assert(node->num_inputs >= 2);
   assert(node->num_inputs <= 3);
   const uint32_t input_id = node->inputs[0];
@@ -655,6 +668,17 @@ static enum xnn_status create_convolution_operator(
         XNN_UNREACHABLE;
     }
   }
+  if (status == xnn_status_success && yolo26_igemm_silu_final_store) {
+    if (input_datatype != xnn_datatype_fp16 ||
+        filter_datatype != xnn_datatype_fp32 ||
+        output_datatype != xnn_datatype_fp16) {
+      xnn_log_error(
+          "YOLO26 IGEMM-SiLU final-store tag selected unexpected datatypes");
+      return xnn_status_invalid_state;
+    }
+    status = xnn_enable_yolo26_f16_igemm_silu_final_store(
+        opdata->operator_objects[0]);
+  }
   return status;
 }
 
@@ -1076,7 +1100,9 @@ enum xnn_status xnn_define_convolution_2d(
   }
 
   const uint32_t supported_flags =
-      XNN_FLAG_TENSORFLOW_SAME_PADDING | XNN_FLAG_TRANSIENT_INDIRECTION_BUFFER;
+      XNN_FLAG_TENSORFLOW_SAME_PADDING | XNN_FLAG_TRANSIENT_INDIRECTION_BUFFER |
+      XNN_FLAG_YOLO26_GEMM_SILU_FINAL_STORE |
+      XNN_FLAG_YOLO26_IGEMM_SILU_FINAL_STORE;
   const uint32_t invalid_flags = flags & ~supported_flags;
   if (invalid_flags != 0) {
     xnn_log_error("failed to define %s operator with 0x%08" PRIx32
@@ -1356,9 +1382,14 @@ enum xnn_status xnn_define_convolution_2d(
                 input_value->datatype, &input_value->shape,
                 input_value->quantization.num_nonbatch_dims);
       }
+      // Only the private fused-GEMM request is meaningful after a 1x1
+      // convolution lowers to fully connected. Convolution padding and IGEMM
+      // flags must not cross that operator boundary.
+      const uint32_t fully_connected_flags =
+          flags & XNN_FLAG_YOLO26_GEMM_SILU_FINAL_STORE;
       return xnn_define_fully_connected(subgraph, output_min, output_max,
                                         input_id, filter_id, bias_id, output_id,
-                                        /*flags=*/0);
+                                        fully_connected_flags);
     }
   }
   struct xnn_node* node = xnn_subgraph_new_node(subgraph);
diff --git a/sources/xnnpack/src/subgraph/fully-connected.c b/sources/xnnpack/src/subgraph/fully-connected.c
index 0dbfcf6..f054f38 100644
--- a/sources/xnnpack/src/subgraph/fully-connected.c
+++ b/sources/xnnpack/src/subgraph/fully-connected.c
@@ -277,6 +277,18 @@ static enum xnn_status create_fully_connected_operator(
     const struct xnn_node* node, const struct xnn_runtime_value* values,
     size_t num_values, struct xnn_operator_data* opdata,
     xnn_weights_cache_t weights_cache) {
+  // Create the normal FP16/FP32/FP16 operator without the private flag, then
+  // replace its final-store microkernel only after its exact type is known.
+  // Rejecting any other type prevents a tagged graph from running without the
+  // SiLU that the fixed YOLO26n topology expects.
+  const bool yolo26_gemm_silu_final_store =
+      (node->flags & XNN_FLAG_YOLO26_GEMM_SILU_FINAL_STORE) != 0;
+  struct xnn_node clean_node;
+  if (yolo26_gemm_silu_final_store) {
+    clean_node = *node;
+    clean_node.flags &= ~XNN_FLAG_YOLO26_GEMM_SILU_FINAL_STORE;
+    node = &clean_node;
+  }
   assert(node->num_inputs >= 2);
   assert(node->num_inputs <= 3);
 
@@ -859,6 +871,16 @@ static enum xnn_status create_fully_connected_operator(
     default:
       XNN_UNREACHABLE;
   }
+  if (status == xnn_status_success && yolo26_gemm_silu_final_store) {
+    if (op_type != fc_type_f16_f32_f16) {
+      xnn_log_error(
+          "YOLO26 GEMM-SiLU final-store tag selected unexpected fully connected type %d",
+          op_type);
+      return xnn_status_invalid_state;
+    }
+    status = xnn_enable_yolo26_f16_gemm_silu_final_store(
+        *fully_connected_op_ptr);
+  }
   return status;
 }
 
