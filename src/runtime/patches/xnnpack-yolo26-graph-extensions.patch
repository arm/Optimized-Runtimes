diff --git a/sources/xnnpack/include/xnnpack.h b/sources/xnnpack/include/xnnpack.h
index 0818889..33baf63 100644
--- a/sources/xnnpack/include/xnnpack.h
+++ b/sources/xnnpack/include/xnnpack.h
@@ -108,6 +108,19 @@ extern "C" {
 /// with any other codepath that could be used in the same compiled XNNPACK library.
 #define XNN_FLAG_SLOW_CONSISTENT_ARITHMETIC 0x00002000
 
+// Requests YOLO26n's FP16 GEMM kernel that applies SiLU before its final
+// store. Runtime construction rejects the node if the selected operator does
+// not match that kernel's fixed contract.
+#define XNN_FLAG_YOLO26_GEMM_SILU_FINAL_STORE 0x40000000
+
+// Requests the equivalent SiLU final-store path for FP16 indirect GEMM.
+// Runtime construction likewise rejects an incompatible operator.
+#define XNN_FLAG_YOLO26_IGEMM_SILU_FINAL_STORE 0x20000000
+
+// Requests the fixed model.2 three-input FP16 concatenate. Reshape rejects
+// tensors outside its documented batch, channel, layout, and shape contract.
+#define XNN_FLAG_YOLO26_FUSED_C2F_CONCATENATE 0x10000000
+
 /// The number of entries in an array of xnn_quantization_params that XNNPACK may read beyond array bounds.
 /// The caller must allocate at least this many extra xnn_quantization_params before passing the array to XNNPACK.
 ///
@@ -561,6 +574,7 @@ enum xnn_unary_operator {
   xnn_unary_square_root,
   xnn_unary_square,
   xnn_unary_tanh,
+  xnn_unary_silu,
   // The following operators are experimental and may be removed.
   xnn_unary_bitwise_not,
   xnn_unary_count_leading_zeros,
@@ -1243,7 +1257,9 @@ enum xnn_status xnn_define_static_reduce_v2(        //
 /// @param output_id - Value ID for the output tensor. The output tensor must be a N-dimensional tensor defined
 ///                    in the @a subgraph with each dimension equal to the dimension of both inputs, except the axis
 ///                    dimension, where it is the sum of the corresponding dimensions of both inputs.
-/// @param flags - binary features of the Concatenate Node. No supported flags are currently defined.
+/// @param flags - binary features of the Concatenate Node. The project-owned
+///                XNN_FLAG_YOLO26_FUSED_C2F_CONCATENATE requests the fixed
+///                model.2 three-way FP16 specialization.
 enum xnn_status xnn_define_concatenate(
   xnn_subgraph_t subgraph,
   int32_t axis,
